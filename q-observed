#!/usr/bin/env bash
# Load configuration and set up logging
source "$(dirname "$0")/config.env" 2>/dev/null || { MEMPALACE_SERVER=${MEMPALACE_SERVER:-}; USERNAME=$(whoami); }
export MEMPALACE_SERVER USERNAME
PROJECT="${PROJECT:-ai-observer}"

# Logging
LOG_DIR="$HOME/.ai-observer/logs"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/$(date +%s).log"
exec > >(tee -a "$LOG_FILE") 2>&1
set -euo pipefail

CAST_DIR="$HOME/.ai-observer/casts"
mkdir -p "$CAST_DIR"
CAST_FILE="$CAST_DIR/session-$(date +%Y%m%d-%H%M%S).cast"

echo "🎬 Starting AI Observer..."
echo "📹 Recording to: $CAST_FILE"
echo ""

asciinema rec "$CAST_FILE" -c "q chat"

echo ""
echo "✅ Session recorded to $CAST_FILE"
echo ""
echo "🧠 Parsing session locally..."

# Parse and clean session
SESSION_TEXT=$(python3 - "$CAST_FILE" <<'PY'
from pathlib import Path
import json, re, sys

file = Path(sys.argv[1])
ANSI = re.compile(r'\x1B[@-_][0-?]*[ -/]*[@-~]')

output = []
with file.open() as f:
    for i, line in enumerate(f):
        if i == 0: continue
        try:
            event = json.loads(line)
            if len(event) >= 3 and event[1] == "o":
                output.append(event[2])
        except: pass

text = ANSI.sub('', "".join(output))
filtered = []
capture = False

for line in text.splitlines():
    line = line.strip()
    if line.startswith(">"): capture = True
    if not capture: continue
    if any(x in line.lower() for x in ["did you know", "mcp server", "loading", "ctrl +", 
        "help all commands", "commands:", "usage:", "using tool:", "allow this action", 
        "running", "with the param", "completed in", "purpose:", "you are chatting with",
        "thinking...", "━━━", "╭─", "│", "╰─"]): continue
    if line: filtered.append(line)

print("\n".join(filtered))
PY
)

if [ ${#SESSION_TEXT} -lt 50 ]; then
    echo "⚠️ Session too small, skipping"
    exit 0
fi

echo "🧠 Analyzing session..."
echo "📊 Captured: $(echo "$SESSION_TEXT" | wc -w) words"

# Get JSON from Q
RESULT=$(printf "%s" "Analyze this DevOps terminal session and return ONLY valid JSON (no other text):

SESSION:
----------------
$SESSION_TEXT
----------------

{
  \"project\": \"$PROJECT\",
  \"timestamp\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",
  \"summary\": \"\",
  \"tasks\": [],
  \"decisions\": [],
  \"commands\": [],
  \"problems\": [],
  \"learnings\": [],
  \"files_created\": [],
  \"files_modified\": [],
  \"technologies\": [],
  \"tags\": []
}

Rules:
- Extract clearly and concisely
- Include ALL filenames in tags
- Detect technologies (docker, aws, kubernetes, bash, python, etc.)
- tags = searchable keywords (lowercase, no spaces)" | q chat --no-interactive 2>&1)

# FIX 1: STRICT JSON VALIDATION - never pass invalid JSON
JSON=$(echo "$RESULT" | python3 -c "
import sys, json, re
text = re.sub(r'\x1B[@-_][0-?]*[ -/]*[@-~]', '', sys.stdin.read())
depth = start = 0
for i, c in enumerate(text):
    if c == '{':
        if depth == 0: start = i
        depth += 1
    elif c == '}':
        depth -= 1
        if depth == 0:
            try:
                obj = json.loads(text[start:i+1])
                if 'project' in obj and 'timestamp' in obj:
                    print(json.dumps(obj, separators=(',', ':')))
                    break
            except: pass
" 2>/dev/null)

# STRICT GATE: validate with jq before accepting
if [ -n "$JSON" ]; then
    VALIDATED=$(echo "$JSON" | jq -c . 2>/dev/null)
    if [ -n "$VALIDATED" ]; then
        JSON="$VALIDATED"
        echo "📊 Session analyzed (validated)"
    else
        JSON=""
    fi
fi

if [ -z "$JSON" ]; then
    echo "⚠️ Invalid JSON from Q → using fallback"
    
    JSON=$(printf "%s" "$SESSION_TEXT" | jq -R -s -c \
        --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '{
            project: "ai-observer",
            timestamp: $ts,
            summary: "fallback: raw session stored",
            tasks: [],
            decisions: [],
            commands: [],
            problems: ["Q returned invalid JSON"],
            learnings: [],
            files_created: [],
            files_modified: [],
            technologies: [],
            tags: ["fallback"],
            raw_text: .
        }')
    
    echo "📊 Using fallback storage"
fi

# Local persistence - ALWAYS save (escape for valid JSON)
mkdir -p ./failed-sessions
echo "$JSON" | jq -c . > "./failed-sessions/$(date +%s).json" 2>/dev/null || echo "$JSON" > "./failed-sessions/$(date +%s).json"

# FIX 2: GUARANTEED STORAGE - never fail on duplicate
set +e  # Don't exit on error for storage
STORAGE_RESULT=$(ssh -o ControlMaster=auto \
    -o ControlPath=/tmp/ssh-mempalace-%r@%h:%p \
    -o ControlPersist=yes \
    root@$MEMPALACE_SERVER bash <<SSHEOF 2>&1
TMP_JSON=\$(mktemp)
cat > "\$TMP_JSON" <<'JSONEOF'
$JSON
JSONEOF
cd /root/mempalace && source venv/bin/activate && python3 - "\$TMP_JSON" <<'PYEOF'
from mempalace.mcp_server import tool_add_drawer, tool_kg_add
import json, time, sys

with open(sys.argv[1], 'r') as f:
    data = f.read()
parsed = json.loads(data)

# GUARANTEED STORAGE: add unique suffix if duplicate
source_file = '$CAST_FILE-' + str(int(time.time()))

try:
    result = tool_add_drawer(
        wing='$PROJECT',
        room='sessions',
        content=data,
        source_file=source_file,
        added_by='ai-observer'
    )
    
    if result.get('success'):
        tool_kg_add(
            subject='prathammodi',
            predicate='worked_on',
            object=parsed['summary'][:100],
            valid_from=parsed['timestamp'].split('T')[0]
        )
        
        for task in parsed['tasks'][:3]:
            tool_kg_add(
                subject='prathammodi',
                predicate='completed_task',
                object=task,
                valid_from=parsed['timestamp'].split('T')[0]
            )
        
        print('SUCCESS')
    else:
        print(f"FAILED: {result}")
except Exception as e:
    print(f'FAILED: {e}')
PYEOF
rm -f "\$TMP_JSON"
SSHEOF
)
set -e  # Re-enable exit on error

if echo "$STORAGE_RESULT" | grep -q "SUCCESS"; then
    echo "✅ Stored in mempalace: ai-observer/sessions"
    echo "🔍 Search with: \"What did I work on today?\""
else
    echo "❌ Storage failed"
    echo "$STORAGE_RESULT"
    echo ""
    echo "💾 Creating emergency backup..."
    ./backup/backup-cast.sh "$CAST_FILE"
    echo "💾 Local JSON saved: ./failed-sessions/$(date +%s).json"
fi

echo ""
echo "📁 Session: $CAST_FILE"
echo "🎬 Replay: asciinema play $CAST_FILE"
