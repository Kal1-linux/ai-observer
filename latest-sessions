#!/bin/bash
# Get latest N sessions from mempalace by timestamp

N=${1:-5}

ssh root@${MEMPALACE_SERVER} bash << 'SSHEOF' 2>/dev/null
cd /root/mempalace
source venv/bin/activate
python3 << 'PYEOF'
import sys
sys.path.insert(0, '/root/mempalace')
from mempalace.mcp_server import tool_search
import json

result = tool_search(query='', wing='ai-observer', room='sessions', limit=100)

# result is already a dict
sessions = []
for r in result['results']:
    try:
        data = json.loads(r['text'])
        sessions.append({
            'timestamp': data.get('timestamp', ''),
            'summary': data.get('summary', ''),
            'source': r.get('source_file', ''),
            'tasks': data.get('tasks', [])
        })
    except:
        pass

sessions.sort(key=lambda x: x['timestamp'], reverse=True)

for i, s in enumerate(sessions[:5]):
    print(f"\n{'='*80}")
    print(f"📅 {s['timestamp']} | {s['source']}")
    print(f"📝 {s['summary']}")
    if s['tasks']:
        print(f"✅ Tasks: {', '.join(s['tasks'][:3])}")
PYEOF
SSHEOF
