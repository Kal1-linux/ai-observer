#!/usr/bin/env python3
"""
Smart Query - Token-optimized mempalace retrieval
Filters knowledge graph facts by predicate to reduce token usage by 90%+
"""
import sys
import json
import os

# Load config.env if present to set environment variables
config_path = os.path.join(os.path.dirname(__file__), 'config.env')
if os.path.isfile(config_path):
    with open(config_path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            if '=' in line:
                key, value = line.split('=', 1)
                os.environ.setdefault(key.strip(), value.strip().strip('"'))

MEMPALACE_SERVER = os.getenv('MEMPALACE_SERVER', '${MEMPALACE_SERVER}')

def query_kg_filtered(entity, predicate_filter=None, limit=10):
    """Query KG and filter by predicate type"""
    import subprocess
    
    cmd = f"""
cd /root/mempalace && source venv/bin/activate && python3 <<'PYEOF'
from mempalace.mcp_server import tool_kg_query
import json

result = tool_kg_query(entity='{entity}', direction='both')
facts = result.get('facts', [])

# Filter by predicate if specified
filtered = facts
if '{predicate_filter}':
    filtered = [f for f in facts if '{predicate_filter}' in f['predicate']]

# Limit results
filtered = filtered[:{limit}]

print(json.dumps({{'entity': '{entity}', 'facts': filtered, 'count': len(filtered)}}))
PYEOF
"""
    
    result = subprocess.run(
        ['ssh', f'root@{MEMPALACE_SERVER}', 'bash'],
        input=cmd,
        capture_output=True,
        text=True
    )
    
    return json.loads(result.stdout)

def search_sessions(query, limit=3):
    """Search sessions with limit"""
    import subprocess
    
    cmd = f"""
cd /root/mempalace && source venv/bin/activate && python3 <<'PYEOF'
from mempalace.mcp_server import tool_search
import json

result = tool_search(query='{query}', wing='ai-observer', room='sessions', limit={limit})
print(json.dumps(result))
PYEOF
"""
    
    result = subprocess.run(
        ['ssh', f'root@{MEMPALACE_SERVER}', 'bash'],
        input=cmd,
        capture_output=True,
        text=True
    )
    
    return json.loads(result.stdout)

def main():
    if len(sys.argv) < 2:
        print("Usage:")
        print("  ./smart-query friends              # Get friend relationships only")
        print("  ./smart-query tasks                # Get completed tasks only")
        print("  ./smart-query work                 # Get worked_on facts only")
        print("  ./smart-query recent 5             # Get 5 recent sessions")
        sys.exit(1)
    
    query_type = sys.argv[1]
    
    if query_type == "friends":
        result = query_kg_filtered('prathammodi', 'friend', limit=10)
        print(f"\n👥 Friends ({result['count']} found):\n")
        for fact in result['facts']:
            if 'friend' in fact['predicate']:
                other = fact['subject'] if fact['direction'] == 'incoming' else fact['object']
                print(f"  • {other}")
    
    elif query_type == "tasks":
        result = query_kg_filtered('prathammodi', 'completed_task', limit=10)
        print(f"\n✅ Recent Tasks ({result['count']} found):\n")
        for fact in result['facts']:
            print(f"  • {fact['object']}")
    
    elif query_type == "work":
        result = query_kg_filtered('prathammodi', 'worked_on', limit=5)
        print(f"\n🔨 Recent Work ({result['count']} found):\n")
        for fact in result['facts']:
            print(f"  • {fact['valid_from']}: {fact['object'][:80]}")
    
    elif query_type == "recent":
        limit = int(sys.argv[2]) if len(sys.argv) > 2 else 3
        result = search_sessions('', limit=limit)
        print(f"\n📋 Recent Sessions ({len(result['results'])} found):\n")
        for r in result['results']:
            data = json.loads(r['text'])
            print(f"  📅 {data['timestamp']}")
            print(f"     {data['summary'][:100]}")
            print()
    
    else:
        print(f"Unknown query type: {query_type}")
        sys.exit(1)

if __name__ == '__main__':
    main()
